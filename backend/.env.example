# ====== Azure OpenAI ======
# Azure Portal → OpenAI 리소스 → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# ====== Azure AI Search ======
# Portal → Search service → Keys, URL
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=
# 통합 인덱스 하나로 운영 (법률·절차·영상 source_type 필터)
AZURE_SEARCH_LAW_INDEX=moving-unified-index
AZURE_SEARCH_PROCEDURE_INDEX=moving-unified-index

# ====== Azure Document Intelligence ======
# SafeContract PDF 업로드 기능에 필요 (미설정 시 PDF 업로드만 비활성)
AZURE_DOCINTEL_ENDPOINT=https://<your-docintel>.cognitiveservices.azure.com/
AZURE_DOCINTEL_API_KEY=

# ====== Azure Blob Storage (현재 미사용, 선택) ======
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=moving-guide-docs

# ====== 공공 API ======
# 공공데이터포털 (아파트 실거래가 조회) — data.go.kr
DATA_GO_KR_SERVICE_KEY=

# 국가법령정보 Open API (law.go.kr) — DRF OC 값
LAW_OC=

# 도로명주소 API (juso.go.kr)
JUSO_API_KEY=
