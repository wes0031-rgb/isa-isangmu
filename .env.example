# 이사이상무 .env.example — 실제 값은 .env 로 복사해서 채우기 (.env 는 git 제외)

# ==========================================
# 도로명주소 검색 API (juso.go.kr)
# ==========================================
JUSO_API_KEY=

# ==========================================
# 공공데이터포털 마스터 서비스키 (data.go.kr)
# ==========================================
DATA_GO_KR_SERVICE_KEY=

# ==========================================
# 국가법령정보 Open API (open.law.go.kr)
# 본인이 가입 시 설정한 OC 영숫자 식별자 (예: msai09sa)
# ==========================================
LAW_OC=

# ==========================================
# Azure OpenAI (필수 — activate_azure.py 실행 전 입력)
# ==========================================
AZURE_OPENAI_ENDPOINT=https://<리소스이름>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# ==========================================
# Azure AI Search (필수)
# ==========================================
AZURE_SEARCH_ENDPOINT=https://<리소스이름>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_LAW_INDEX=moving-law-index
AZURE_SEARCH_PROCEDURE_INDEX=moving-procedure-index

# ==========================================
# Azure Document Intelligence (옵션 — SafeContract PDF 업로드용)
# ==========================================
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_API_KEY=

# ==========================================
# Azure Blob Storage (옵션 — 원본 문서 저장용)
# ==========================================
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=moving-guide-docs
