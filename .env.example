# 이사이상무 .env.example — 실제 값은 .env 로 복사해서 채우기 (.env 는 git 제외)

# ==========================================
# Azure OpenAI (필수)
# ==========================================
AZURE_OPENAI_ENDPOINT=https://<리소스이름>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# ==========================================
# Azure AI Search (필수, 2-index 체제 — 영상 인덱스 제거됨 2026-04-23)
# ==========================================
AZURE_SEARCH_ENDPOINT=https://<리소스이름>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_LAW_INDEX=law-index
AZURE_SEARCH_GUIDE_INDEX=guide-index
AZURE_SEARCH_LAW_SEMANTIC_CONFIG=law-semantic-config
AZURE_SEARCH_GUIDE_SEMANTIC_CONFIG=guide-semantic-config

# ==========================================
# Azure Document Intelligence (옵션 — SafeContract PDF 업로드용)
# ==========================================
AZURE_DOCINTEL_ENDPOINT=
AZURE_DOCINTEL_API_KEY=
# 모델 ID: 기본은 'prebuilt-layout' (범용 레이아웃 추출)
AZURE_DOCINTEL_MODEL_ID=prebuilt-layout
# Custom Neural 모델 (등기부 구조화 24필드 추출) — 공란이면 Custom 경로 비활성
# layout+LLM 결과에 보조 머지 (식별 필드 conf>0.8 덮어씀 + 위험 플래그 OR)
AZURE_DOCINTEL_CUSTOM_MODEL_ID=

# ==========================================
# Azure Blob Storage (옵션 — 원본 문서 저장용)
# ==========================================
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=iim-rag-source

# ==========================================
# Azure Speech-to-Text (옵션 — 챗봇 마이크 입력)
# ==========================================
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus2
AZURE_SPEECH_LANGUAGE=ko-KR

# ==========================================
# 도로명주소 검색 API (juso.go.kr)
# ==========================================
JUSO_API_KEY=

# ==========================================
# 공공데이터포털 마스터 서비스키 (data.go.kr)
# 국토부 아파트 매매 실거래가 자동 조회용 — 별도 활용신청 필요
# https://www.data.go.kr/data/15057511/openapi.do
# ==========================================
DATA_GO_KR_SERVICE_KEY=

# ==========================================
# 국가법령정보 Open API (open.law.go.kr)
# 본인이 가입 시 설정한 OC 영숫자 식별자 (예: msai09sa)
# ==========================================
LAW_OC=
